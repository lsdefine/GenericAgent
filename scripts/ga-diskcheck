#!/usr/bin/env python3
"""磁盘告警检查脚本 — 检查磁盘使用率，超过阈值则告警"""
import os, sys, argparse

def check_disk(path='/', warn_threshold=80, crit_threshold=90, quiet=False):
    """检查磁盘使用率"""
    try:
        st = os.statvfs(path)
        total = st.f_frsize * st.f_blocks
        free = st.f_frsize * st.f_bfree
        used = total - free
        used_percent = round(used / total * 100, 1)
        free_gb = round(free / (1024**3), 1)
        total_gb = round(total / (1024**3), 1)
    except Exception as e:
        if not quiet:
            print(f"DISKCHECK CRITICAL: 无法检查磁盘 - {e}")
        return 2
    
    if used_percent >= crit_threshold:
        if not quiet:
            print(f"DISKCHECK CRITICAL: {path} 使用率 {used_percent}% (阈值: {crit_threshold}%)")
            print(f"  总容量: {total_gb}G, 剩余: {free_gb}G")
        return 2
    elif used_percent >= warn_threshold:
        if not quiet:
            print(f"DISKCHECK WARNING: {path} 使用率 {used_percent}% (阈值: {warn_threshold}%)")
            print(f"  总容量: {total_gb}G, 剩余: {free_gb}G")
        return 1
    else:
        if not quiet:
            print(f"DISKCHECK OK: {path} 使用率 {used_percent}%, 剩余 {free_gb}G / {total_gb}G")
        return 0

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='GA磁盘告警检查')
    parser.add_argument('--quiet', action='store_true', help='静默模式，仅返回退出码')
    parser.add_argument('--warn', type=int, default=80, help='警告阈值(默认80%)')
    parser.add_argument('--crit', type=int, default=90, help='严重阈值(默认90%)')
    parser.add_argument('--path', default='/', help='检查路径')
    args = parser.parse_args()
    
    exit_code = check_disk(args.path, args.warn, args.crit, args.quiet)
    sys.exit(exit_code)
