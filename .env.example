# ── aduAgent 环境变量配置 (.env) ───────────────────────────────
# 复制本文件为 .env 后填入真实值，切勿提交到 Git

# Proxy
ADU_PROXY=http://127.0.0.1:2082

# mixin_config
ADU_MIXIN_BASE_DELAY=5
ADU_MIXIN_LLM_NOS=gpt-4o
ADU_MIXIN_MAX_RETRIES=3

# native_oai_config_kimi
ADU_KIMI_NAME=kimi
ADU_KIMI_MODEL=gpt-4o
ADU_KIMI_APIBASE=https://api.moonshot.cn/v1
ADU_KIMI_APIKEY=sk-your-key-here
ADU_KIMI_CONNECT_TIMEOUT=10
ADU_KIMI_READ_TIMEOUT=180
ADU_KIMI_MAX_RETRIES=3
